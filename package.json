{
  "name": "azf-krr",
  "version": "1.2.0",
  "description": "KRR Azure function",
  "main": "dist/functions/*.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "biome check",
    "start": "npm run build && func start",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "refresh": "rm -rf node_modules/ && rm package-lock.json && npm i",
    "encode-private-key": "node dev/encode-private-key-pem.ts"
  },
  "keywords": [
    "vfk",
    "difi",
    "digdir",
    "krr",
    "kor",
    "kontakt- og reservasjonsregisteret"
  ],
  "author": {
    "name": "Rune Moskvil Lyngås",
    "email": "rune.moskvil.lyngas@vestfoldfylke.no",
    "url": "https://github.com/runely"
  },
  "license": "MIT",
  "dependencies": {
    "@azure/functions": "^4.16.0",
    "@vestfoldfylke/loglady": "^2.1.0",
    "jose": "^6.2.3",
    "openid-client": "^6.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}
